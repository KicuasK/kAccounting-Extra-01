.DS_Store
.env
.env.*
!.env.example

# Rust
target/

# Node / Vite
node_modules/
dist/
.vite/

# Local runtime data
*.sqlite
*.sqlite-shm
*.sqlite-wal
*.sqlite-journal
*.sqlite3
*.sqlite3-shm
*.sqlite3-wal
*.sqlite-journal
*.sqlite3-journal
*.db
*.db-*
*.db3
*.db3-*
*.kagextra
*.kagextra.partial
.kAccounting-Extra-01-backup-*/
.kAccounting-Extra-01-object-*/
backups/

# Editors
.idea/
.vscode/

# Encrypted runtime objects, local backups, and private work
*.kae
*.kabackup/
.kAccounting-Extra-01-encrypted-backup-*.work/
device-key.json

# Runtime coordination and local Python caches
*.managed/
.runtime.lock
.maintenance.lock
.backup-service.lock
.kAccounting-Extra-01-init-*/
__pycache__/
*.pyc

# Machine-local, reviewed operator launchers; runtime state stays outside source
/scripts/private-acceptance-local/

# Interrupted transfer work must never enter source control
.kAccounting-Extra-01-*.work/
.kAccounting-Extra-01-recipient-import-*/
.kAccounting-Extra-01-container-import-*/
.kAccounting-Extra-01-ciphertext-*.partial/
.migration-work-*/
operation-state.json
.operation-state.lock
.operation-state-*.tmp
